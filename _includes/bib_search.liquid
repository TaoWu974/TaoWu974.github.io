{% if site.bib_search %}
  <div class="publication-filter" markdown="0">
    <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
    <input
      type="text"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      aria-label="{% if page.lang == 'zh-CN' %}筛选论文{% else %}Filter publications{% endif %}"
      placeholder="{% if page.lang == 'zh-CN' %}输入关键词筛选论文{% else %}Type to filter{% endif %}"
    >
  </div>
{% endif %}
